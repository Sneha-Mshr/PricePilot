PROJECT_NAME=PricePilot

# PostgreSQL connection string.
# Managed providers give you a `postgres://...` URL — that is fine, it is
# normalised automatically. Percent-encode special characters in the password
# (# -> %23, @ -> %40).
DATABASE_URL=postgresql://postgres:password@localhost:5432/pricepilot

# Comma-separated list of frontend origins allowed to call this API.
# In production set this to your deployed frontend URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API key for the shopping chatbot.
# Get one free at https://aistudio.google.com/apikey
# Leave empty to fall back to canned rule-based replies.
GEMINI_API_KEY=
